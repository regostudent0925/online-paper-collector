# 승인된 소스만 추적하는 허용 목록. 실제 기록·산출물·계정 설정은 추적하지 않는다.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/package.json
!/src/
!/ui/
!/test/
!/browser-helper/
!/examples/
!/tools/
/tools/*
!/tools/git-publish.mjs
!/tools/setup-local-data.mjs
!/tools/import-npay-missions.mjs
/examples/*
!/examples/data/
**/.env
**/.env.*
**/*secret*
**/*credential*
**/node_modules/
**/*.log
**/*.tmp
**/write.lock
**/.DS_Store
**/Thumbs.db
